# Copy this file to .env and adjust if needed:
#   cp .env.example .env

# Local MongoDB (default). Works with a standard `mongod` install —
# the database and collections are created automatically on first write.
MONGODB_URI=mongodb://127.0.0.1:27017/spendwise

# Or use a free MongoDB Atlas cluster instead (no local install needed).
# Replace <user>, <password> and <cluster>, and keep the database name:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spendwise?retryWrites=true&w=majority

# Port the API listens on. The React dev server proxies /api here.
PORT=5000

# Origin allowed by CORS. The Vite dev server runs on 5173.
CLIENT_ORIGIN=http://localhost:5173
